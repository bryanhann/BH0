#!/usr/bin/env bash

_export () { export $1=$2 ; }

_export BH0        $(readlink ${BASH_SOURCE[0]})
_export BH0_INIT   $BH0.init
_export BH0_TESTS  $BH0.tests
_export BH0_SRC    $BH0.src

_export BH0_BUILD  ${HOME}/.bh0.build
_export BH0_BCH    $BH0_BUILD/bch
_export BH0_BATS   $BH0_BUILD/bats

source $BH0_INIT/init.sh

0fds && [ $1. == . ] && return


if [ $1. == --init. ]; then
    $f
fi


if  [ $1. == --test. ]; then
    $BH0_TESTS/runtests
    $f
fi

if [ -f $BH0.d/$1   ]; then 
    $d $BH0.d/$*
    $f $? 
fi

 

:usage $BH0
