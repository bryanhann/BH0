#!/usr/bin/env bash

__000handle () {
    local real=$1
    local zero=$2
    shift 2
#    [ ! $real. == ${BASH_SOURCE[0]}. ] && echo mismatch1 && read
#    [ ! $zero. == $0.                ] && echo mismatch2 && read
    [   $real. == $zero. ] && d=  && f=exit
    [ ! $real. == $zero. ] && d=. && f=return
    [ -f $real.d/$1 ] && { $d $real.d/$*;  $f $? ; }
    0bold try:
    for name in $(ls ${real}.d); do 
        0bold "   $(basename $real) $name";  
    done
}
