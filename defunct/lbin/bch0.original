#!/usr/bin/env bash
. bch0-init

this=${BASH_SOURCE[0]}
[ ! ${this}. == ${0}. ] && [ $1. ==       . ] && return
[ ! ${this}. == ${0}. ] && [ $1. == --init. ] && return
[ ! ${this}. == ${0}. ] && dot=.
[ ! ${this}. == ${0}. ] && fin=return
[   ${this}. == ${0}. ] && dot=
[   ${this}. == ${0}. ] && fin=exit


[ "${dot}" == "." ] && [ $1. == .       ] && return
[ "${dot}" == "." ] && [ $1. == --flag. ] && return
real=$(resolve0 $this)


export BCH0__root_pid=$$



#================================================================
# ${this} : the path by which this script was called or sourced
# ${real} : the real path to this script with symlinks resolved
#================================================================


readlink $this > /dev/null cmd0=

 
#================================================================
# set variables differently if called or sources
# ${dot} : . or empty
# ${fin} : return or exit
# ${bin} : ${real}.d  (directory of subcommands)
# ${cmd0} : basename of the command (use $this over $real)
##================================================================

if [ ${this}. == ${0}. ]; then
    #------------------------------------------
    # We were called
    #------------------------------------------
    export dot=
    export fin=exit
    export bin=${real}.d
    export cmd0=$(strip0 "${cmd0} $(basename ${this})")
    #export cmd0="${cmd0} $(basename ${this})"
else
    #------------------------------------------
    # We were sourced
    #------------------------------------------
    dot=.
    fin=return
    bin=${real}.d
    cmd0="${cmd0} $(basename ${this})"
fi

[ $1. == --help. ] && usage0
[ $1. == --help. ] && echo cone && $fin


#================================================================
# If subcommand [$1] is found, invoke it and finisish.
#================================================================

if [ -f ${bin}/$1 ]; then
    $dot ${bin}/$*
    $fin $?
fi

#================================================================
# Else if subcommand [help] is found, invoke it and finish.
#================================================================

#if [ -f ${bin}/help ]; then
#    $dot ${bin}/help $*
#    $fin $?
#fi

#================================================================
# Else handle usage here
#================================================================

echo 888
usage0
