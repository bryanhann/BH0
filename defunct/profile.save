#!/usr/bin/env bash

#####################################################
#                                                   #
#    START OF SCRIPT                                #
#                                                   #
#    This is a minimalist .profile script. If       #
#    you want to add functionally, consider         #
#    adding to .bashrc first. Things that should    #
#    be done only once can be done there as long    #
#    as proper checking is done.                    #
#                                                   #
#####################################################


#====================================================
#  Initial words
#====================================================

    echo ---.profile begin-----------------------


#====================================================
#  Exit control
#----------------------------------------------------
#  Intercept the 'exit' command to prevent
#  accidentaly closing a terminal session
#====================================================

    print_exit_warning () { 
        echo
        echo "    ################################"
        echo "    #  YOU ARE IN THE LOGIN SHELL  #"
        echo "    #  use 'builtin exit' to exit  #"
        echo "    ################################"
        echo
    }

    exit () { 
        print exit_warning 
    }


#====================================================
#  The local bin (BCH_LBIN)
#----------------------------------------------------
#  Configure our preferred path to our local bin.
#  Guarantee it exists and is on PATH.
#====================================================

    export BCH_LBIN=${HOME}/.local/bin
    mkdir -p ${BCH_LBIN}
    if [[ ! ":${PATH}:" == *":${BCH_LBIN}:"* ]]
    then
        export PATH=${PATH}:${BCH_LBIN}
    fi


#====================================================
#  Legacy export. Seek its removal
#====================================================

    export BCH_000_INITIALIZED=1


#====================================================
#  Final words
#====================================================

    echo "to turn on debugging, try 'touch ~/DEBUG'"
    echo ---.profile end-------------------------


#====================================================
# Start subshell; print warning when it ends
#====================================================

    bash
    print_exit_warning


#####################################################
#                                                   #
#    END OF SCRIPT.                                 #
#                                                   #
#    Nothing below is under version control.        #
#                                                   #
#####################################################
